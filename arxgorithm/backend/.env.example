# arXiv API
ARXIV_RATE_LIMIT=3.0

# Nebius Embedding Service
NEBIUS_API_KEY=your-api-key-here
NEBIUS_API_URL=https://api.nebius.ai/v1

# Gemini Summary Service
GEMINI_API_KEY=your-api-key-here

# OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Session
SESSION_SECRET=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./arxgorithm.db

# Frontend
FRONTEND_URL=http://localhost:3000

# Backend (used for OAuth callback URIs)
BACKEND_URL=http://localhost:8000
