# arXiv API
ARXIV_RATE_LIMIT=3.0

# SaladCloud Embedding Service
SALAD_API_KEY=your-api-key-here
SALAD_ORGANIZATION_NAME=your-org-name
SALAD_INFERENCE_ENDPOINT_NAME=qwen3-embedding

# Gemini Summary Service
GEMINI_API_KEY=your-api-key-here

# OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Session
SESSION_SECRET=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./arxgorithm.db

# Frontend
FRONTEND_URL=http://localhost:3000

# Backend (used for OAuth callback URIs)
BACKEND_URL=http://localhost:8000
