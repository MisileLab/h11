{
  "name": "astrojs",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --ignore-path /dev/null \"src/**/*.{js,mjs,cjs,ts,tsx}\" \"astro.config.mjs\" && eslint \"src/**/*.{js,mjs,cjs,ts,astro}\" \"astro.config.mjs\"",
    "lint:fix": "oxlint --ignore-path /dev/null \"src/**/*.{js,mjs,cjs,ts,tsx}\" \"astro.config.mjs\" --fix && eslint \"src/**/*.{js,mjs,cjs,ts,astro}\" \"astro.config.mjs\" --fix",
    "lint:ox": "oxlint --ignore-path /dev/null \"src/**/*.{js,mjs,cjs,ts,tsx}\" \"astro.config.mjs\"",
    "lint:ox:fix": "oxlint --ignore-path /dev/null \"src/**/*.{js,mjs,cjs,ts,tsx}\" \"astro.config.mjs\" --fix",
    "format": "oxfmt --ignore-path /dev/null . '!pnpm-workspace.yaml'",
    "format:check": "oxfmt --check --ignore-path /dev/null . '!pnpm-workspace.yaml'"
  },
  "dependencies": {
    "@astrojs/node": "11.0.3",
    "@astrojs/sitemap": "3.7.3",
    "@misile/satellite": "0.0.5",
    "astro": "7.1.6",
    "dayjs": "1.11.21",
    "mobile-device-detect": "0.4.3",
    "nanostores": "1.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-oxlint": "^1.51.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.51.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@11.18.0"
}
