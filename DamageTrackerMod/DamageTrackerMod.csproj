<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>DamageTracker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GodotSharpPath Condition="'$(GodotSharpPath)' == ''">$(MSBuildProjectDirectory)/lib/GodotSharp.dll</GodotSharpPath>
    <HarmonyXPath Condition="'$(HarmonyXPath)' == ''">$(MSBuildProjectDirectory)/lib/HarmonyX.dll</HarmonyXPath>
    <Sts2CorePath Condition="'$(Sts2CorePath)' == ''">/Users/misile/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64/sts2.dll</Sts2CorePath>
    <UseDamageTrackerStubs Condition="!Exists('$(GodotSharpPath)') or !Exists('$(HarmonyXPath)')">true</UseDamageTrackerStubs>
    <DefineConstants Condition="'$(UseDamageTrackerStubs)' == 'true'">$(DefineConstants);DAMAGE_TRACKER_STUBS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseDamageTrackerStubs)' == 'true'">
    <Compile Include="Stubs/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GodotSharpPath)')">
    <Reference Include="GodotSharp">
      <HintPath>$(GodotSharpPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(HarmonyXPath)')">
    <Reference Include="HarmonyX">
      <HintPath>$(HarmonyXPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(Sts2CorePath)')">
    <Reference Include="sts2">
      <HintPath>$(Sts2CorePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseDamageTrackerStubs)' != 'true'">
    <PackageReference Include="HarmonyX" Version="2.16.0" />
  </ItemGroup>

</Project>
