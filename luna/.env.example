# Opencode SDK Configuration
APP_ID=your_app_id_here

# GitHub App Private Key
PRIVATE_KEY_PATH=./private-key.pem

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PROXY_URL=https://webhook.site/your-unique-id

# Allowed User Configuration
# GitHub username allowed to create PRs that trigger Luna reviews (default: misilelab)
ALLOWED_USER=misilelab
