# Production Environment Configuration
# Copy to .env and fill in actual values

# Environment
DEV=false
NODE_ENV=production

# GitHub (for image names)
GITHUB_REPOSITORY=misilelab/corin
IMAGE_TAG=latest

# Database (use managed PostgreSQL in production)
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/corin
POSTGRES_DB=corin
POSTGRES_USER=corin
POSTGRES_PASSWORD=<secure-random-password>
POSTGRES_PORT=5432

# Redis (use managed Redis in production)
REDIS_URL=redis://:password@your-redis-host:6379/0
REDIS_PASSWORD=<secure-random-password>
REDIS_PORT=6379

# AWS S3 (production storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=<aws-access-key>
S3_SECRET_ACCESS_KEY=<aws-secret-key>
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=corin-prod-originals
S3_BUCKET_PLAYBACK=corin-prod-playback
S3_BUCKET_CLIPS=corin-prod-clips
S3_PRESIGNED_URL_EXPIRY=3600

# Google OAuth
GOOGLE_CLIENT_ID=<prod-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<prod-client-secret>
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback/google

# JWT
JWT_SECRET=<secure-random-secret-min-64-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-proj-<your-key>
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pricing (USD per 1M tokens)
TRANSCRIBE_INPUT_USD_PER_1M=10.0
TRANSCRIBE_AUDIO_USD_PER_1M=60.0
TRANSCRIBE_OUTPUT_USD_PER_1M=40.0
EMBEDDING_USD_PER_1M=0.13
CHAT_INPUT_USD_PER_1M=0.15
CHAT_OUTPUT_USD_PER_1M=0.60

# VAD Configuration
VAD_PROVIDER=silero
VAD_PADDING_MS=300
VAD_MIN_SPEECH_MS=200
VAD_MERGE_GAP_MS=200
VAD_MIN_SEGMENT_MS=400

# Processing
MAX_UPLOAD_SIZE_MB=2048
STT_MAX_CHUNK_SIZE_MB=24
AUDIO_SAMPLE_RATE=16000
PLAYBACK_BITRATE=64k

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=https://yourdomain.com

# Ports (if running multiple instances)
WEB_PORT=3000
