# Environment
DEV=true
NODE_ENV=development

# Database
DATABASE_URL=postgresql://corin:corin_dev_password@localhost:5432/corin

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
# If DEV=true, uses MinIO; otherwise AWS S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=corin-originals
S3_BUCKET_PLAYBACK=corin-playback
S3_BUCKET_CLIPS=corin-clips
S3_PRESIGNED_URL_EXPIRY=3600

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# JWT
JWT_SECRET=your-secure-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pricing (USD per 1M tokens) - for cost tracking
TRANSCRIBE_INPUT_USD_PER_1M=10.0
TRANSCRIBE_AUDIO_USD_PER_1M=60.0
TRANSCRIBE_OUTPUT_USD_PER_1M=40.0
EMBEDDING_USD_PER_1M=0.13
CHAT_INPUT_USD_PER_1M=0.15
CHAT_OUTPUT_USD_PER_1M=0.60

# VAD Configuration
VAD_PROVIDER=silero
VAD_PADDING_MS=300
VAD_MIN_SPEECH_MS=200
VAD_MERGE_GAP_MS=200
VAD_MIN_SEGMENT_MS=400

# Processing
MAX_UPLOAD_SIZE_MB=2048
STT_MAX_CHUNK_SIZE_MB=24
AUDIO_SAMPLE_RATE=16000
PLAYBACK_BITRATE=64k

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000
