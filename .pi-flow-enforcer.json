{
  "approvalToken": "/approve",
  "bigCommitThresholds": {
    "locChanged": 350,
    "filesChanged": 12
  },
  "contextManager": {
    "maxFiles": 6,
    "maxChars": 24000,
    "priorities": [
      "README*",
      "docs/README*",
      "docs/overview*",
      "docs/architecture*",
      "package.json",
      "pyproject.toml",
      "Cargo.toml",
      "go.mod",
      "CONTRIBUTING*",
      "Makefile",
      "justfile",
      "main.*",
      "index.*",
      "app.*"
    ]
  },
  "commitStyle": "conventional"
}
